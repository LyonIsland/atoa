# Copy this file to .env. Never commit the populated .env file.
PORT=7000
PUBLIC_URL=https://atoa.example.com

# Persist identity, sessions, task payloads, and contribution audit in SQLite
# outside the source tree. The process user needs read/write access to this directory.
ATOA_SQLITE_FILE=./data/atoa.sqlite

# Optional one-time import source for deployments upgrading from the former
# JSON store. Leave empty for a new deployment.
ATOA_LEGACY_JSON_FILE=

# This open-source release contains only the courseplanner project.
ATOA_CLOUD_ROOT=./cloud-projects
ATOA_MANAGED_PROJECTS_ROOT=./data/projects
ATOA_DEMO_HISTORY_ROOT=./data/demo-history

# Recommended for any Internet-facing deployment. Share it out of band with
# invited users; do not commit a real value.
ATOA_INVITE_CODE=replace-with-a-long-random-invite-code

# Optional external Program Projects. Leave empty for the default one-project
# deployment. Multiple entries use the operating system PATH separator.
# Linux/macOS example: docs=/srv/projects/docs:website=/srv/projects/website
ATOA_PROGRAM_PROJECTS=
