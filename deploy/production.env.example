# Install as /etc/atoa/atoa.env with owner root:atoa and mode 0640.
NODE_ENV=production
PORT=7000
PUBLIC_URL=https://atoa.example.com

ATOA_SQLITE_FILE=/var/lib/atoa/atoa.sqlite
ATOA_MANAGED_PROJECTS_ROOT=/var/lib/atoa/projects
ATOA_DEMO_HISTORY_ROOT=/var/lib/atoa/demo-history
# The server merges accepted candidates here, so this authoritative project root
# belongs to the protected data volume rather than the read-only release tree.
ATOA_CLOUD_ROOT=/var/lib/atoa/cloud-projects

# Generate in a password manager. Never commit the populated value.
ATOA_INVITE_CODE=replace-with-at-least-32-random-characters
ATOA_LEGACY_JSON_FILE=
ATOA_PROGRAM_PROJECTS=
